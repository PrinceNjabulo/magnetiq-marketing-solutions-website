# Supabase Postgres connection strings — Project Settings -> Database -> Connection string,
# in the Supabase dashboard for project ref wnxkwxgvjwpchaztnhol.
# DATABASE_URL: pooled (transaction mode, port 6543) connection, used at runtime by the app.
DATABASE_URL="postgresql://postgres.wnxkwxgvjwpchaztnhol:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: unpooled (port 5432) connection, used only by `prisma migrate` for schema changes.
DIRECT_URL="postgresql://postgres.wnxkwxgvjwpchaztnhol:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Anthropic Claude API key, used to generate audit reports (Phase 4)
ANTHROPIC_API_KEY=""

# Google PageSpeed Insights API key, used by the crawler for performance/Core Web Vitals data (Phase 2)
PAGESPEED_API_KEY=""

# Transactional email provider API key, used to send the report email (Phase 5)
RESEND_API_KEY=""
