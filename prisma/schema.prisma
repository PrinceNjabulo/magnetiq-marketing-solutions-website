generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditStatus {
  pending
  crawling
  analyzing
  generating
  done
  failed
}

enum FollowUpType {
  report_email
  reminder
  book_call_nudge
}

enum FollowUpStatus {
  scheduled
  sent
  cancelled
}

model Lead {
  id          String   @id @default(cuid())
  email       String
  companyName String?
  websiteUrl  String
  source      String   @default("audit_landing_page")
  createdAt   DateTime @default(now())

  audits    Audit[]
  followUps FollowUp[]

  @@index([email])
}

model Audit {
  id            String      @id @default(cuid())
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String
  url           String
  status        AuditStatus @default(pending)
  failureReason String?

  rawCrawlJson   Json?
  analysisJson   Json?
  reportMarkdown String?
  reportHtml     String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  followUps FollowUp[]

  @@index([leadId])
  @@index([status])
}

model FollowUp {
  id          String         @id @default(cuid())
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  audit       Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  auditId     String
  type        FollowUpType
  status      FollowUpStatus @default(scheduled)
  scheduledAt DateTime
  sentAt      DateTime?

  @@index([leadId])
  @@index([auditId])
  @@index([status, scheduledAt])
}
